-- LibraTrack - Library Book Management System
-- Database Management System LAB project
-- Dialect : MySQL 8.x (MySQL Workbench / phpMyAdmin / XAMPP)
-- Same tables, keys and sample data as library_sqlite.sql
-- =====================================================================

DROP DATABASE IF EXISTS library_db;
CREATE DATABASE library_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE library_db;

-- Parent table -------------------------------------------------------
CREATE TABLE categories (
    category_id   INT          NOT NULL AUTO_INCREMENT,
    category_name VARCHAR(60)  NOT NULL,
    PRIMARY KEY (category_id),
    UNIQUE KEY uq_category_name (category_name)
) ENGINE = InnoDB;

-- Child table (category_id is a FOREIGN KEY) -------------------------
CREATE TABLE books (
    book_id      INT           NOT NULL AUTO_INCREMENT,
    isbn         VARCHAR(20)   NOT NULL,
    title        VARCHAR(150)  NOT NULL,
    author       VARCHAR(100)  NOT NULL,
    category_id  INT           NOT NULL,
    publish_year SMALLINT      NOT NULL,
    price        DECIMAL(10,2) NOT NULL,
    status       ENUM('Available', 'Borrowed', 'Reserved') NOT NULL DEFAULT 'Available',
    added_on     DATE          NOT NULL,
    PRIMARY KEY (book_id),
    UNIQUE KEY uq_isbn (isbn),
    CONSTRAINT chk_year  CHECK (publish_year BETWEEN 1000 AND 2100),
    CONSTRAINT chk_price CHECK (price >= 0),
    CONSTRAINT fk_books_category FOREIGN KEY (category_id)
        REFERENCES categories (category_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
) ENGINE = InnoDB;

CREATE INDEX idx_books_category ON books (category_id);
CREATE INDEX idx_books_status   ON books (status);

